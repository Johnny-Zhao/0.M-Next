<xmi:XMI xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
         xmlns:uml="http://www.omg.org/spec/UML/20131001"
         xmlns:sysml="http://www.omg.org/spec/SysML/20181001/SysML"
         xmlns:mnext="urn:m-next:exchange:sysml">
  <uml:Model xmi:id="model">
    <packagedElement xmi:type="uml:Class" xmi:id="B1" name="Engine"/>
    <packagedElement xmi:type="uml:Class" xmi:id="R1" name="Safety Requirement">
      <ownedAttribute xmi:type="uml:Property" xmi:id="R1-req-id" name="req_id" type="String" mnext:value="REQ-1"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="R1-text" name="text" type="String" mnext:value="Engine shall be safe"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Association" xmi:id="A1" memberEnd="A1-source A1-target">
      <ownedEnd xmi:type="uml:Property" xmi:id="A1-source" type="B1"/>
      <ownedEnd xmi:type="uml:Property" xmi:id="A1-target" type="R1"/>
    </packagedElement>
  </uml:Model>
  <sysml:Block base_Class="B1"/>
  <sysml:Requirement base_Class="R1"/>
</xmi:XMI>
