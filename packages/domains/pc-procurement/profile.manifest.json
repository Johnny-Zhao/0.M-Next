{
  "id": "pc-procurement",
  "name": "电脑采购",
  "version": "1.1.0",
  "templateCode": "pc_procurement",
  "tags": {
    "industry": ["信息技术"],
    "profession": ["采购", "硬件"],
    "scenario": ["电脑采购"]
  },
  "valueTypes": [],
  "objectTypes": [
    {
      "code": "procurement_requirement",
      "name": "采购需求"
    },
    {
      "code": "hardware_product",
      "name": "硬件配件"
    },
    {
      "code": "supplier",
      "name": "供应商"
    },
    {
      "code": "supplier_quote",
      "name": "供应商报价"
    },
    {
      "code": "build_plan",
      "name": "装机方案"
    },
    {
      "code": "build_plan_item",
      "name": "方案明细"
    }
  ],
  "fields": [
    {
      "objectType": "procurement_requirement",
      "code": "code",
      "name": "编码",
      "dataType": "string",
      "required": true
    },
    {
      "objectType": "procurement_requirement",
      "code": "name",
      "name": "名称",
      "dataType": "string",
      "required": true
    },
    {
      "objectType": "procurement_requirement",
      "code": "job_role",
      "name": "岗位",
      "dataType": "string",
      "required": true
    },
    {
      "objectType": "procurement_requirement",
      "code": "quantity",
      "name": "采购数量",
      "dataType": "number",
      "required": true
    },
    {
      "objectType": "procurement_requirement",
      "code": "unit_budget_cny",
      "name": "单台预算（元）",
      "dataType": "number",
      "required": true
    },
    {
      "objectType": "procurement_requirement",
      "code": "warranty_requirement",
      "name": "保修要求",
      "dataType": "string",
      "required": true
    },
    {
      "objectType": "procurement_requirement",
      "code": "os_requirement",
      "name": "系统要求",
      "dataType": "string",
      "required": true
    },
    {
      "objectType": "procurement_requirement",
      "code": "max_total_power_w",
      "name": "整机最大设计功耗（瓦）",
      "dataType": "number",
      "required": true
    },
    {
      "objectType": "hardware_product",
      "code": "code",
      "name": "编码",
      "dataType": "string",
      "required": true
    },
    {
      "objectType": "hardware_product",
      "code": "name",
      "name": "名称",
      "dataType": "string",
      "required": true
    },
    {
      "objectType": "hardware_product",
      "code": "category",
      "name": "品类",
      "dataType": "enum",
      "required": true,
      "constraints": {
        "enumValues": [
          "CPU",
          "MAINBOARD",
          "MEMORY",
          "GPU",
          "PSU",
          "STORAGE",
          "CASE",
          "COOLER",
          "MONITOR",
          "PERIPHERAL"
        ]
      }
    },
    {
      "objectType": "hardware_product",
      "code": "reference_price_cny",
      "name": "参考价（元）",
      "dataType": "number",
      "required": true
    },
    {
      "objectType": "hardware_product",
      "code": "performance_score",
      "name": "性能分",
      "dataType": "number",
      "required": true
    },
    {
      "objectType": "hardware_product",
      "code": "power_w",
      "name": "功耗（瓦）",
      "dataType": "number",
      "required": true
    },
    {
      "objectType": "hardware_product",
      "code": "psu_capacity_w",
      "name": "电源容量（瓦）",
      "dataType": "number",
      "required": false
    },
    {
      "objectType": "hardware_product",
      "code": "cpu_mainboard_platform_code",
      "name": "CPU/主板平台编码",
      "dataType": "number",
      "required": false
    },
    {
      "objectType": "hardware_product",
      "code": "memory_platform_code",
      "name": "内存平台编码",
      "dataType": "number",
      "required": false
    },
    {
      "objectType": "supplier",
      "code": "code",
      "name": "编码",
      "dataType": "string",
      "required": true
    },
    {
      "objectType": "supplier",
      "code": "name",
      "name": "名称",
      "dataType": "string",
      "required": true
    },
    {
      "objectType": "supplier_quote",
      "code": "code",
      "name": "编码",
      "dataType": "string",
      "required": true
    },
    {
      "objectType": "supplier_quote",
      "code": "name",
      "name": "名称",
      "dataType": "string",
      "required": true
    },
    {
      "objectType": "supplier_quote",
      "code": "unit_price_cny",
      "name": "报价单价（元）",
      "dataType": "number",
      "required": true
    },
    {
      "objectType": "supplier_quote",
      "code": "inventory_qty",
      "name": "报价库存",
      "dataType": "number",
      "required": true
    },
    {
      "objectType": "supplier_quote",
      "code": "delivery_days",
      "name": "交付周期（天）",
      "dataType": "number",
      "required": true
    },
    {
      "objectType": "build_plan",
      "code": "code",
      "name": "编码",
      "dataType": "string",
      "required": true
    },
    {
      "objectType": "build_plan",
      "code": "name",
      "name": "名称",
      "dataType": "string",
      "required": true
    },
    {
      "objectType": "build_plan",
      "code": "status",
      "name": "生命周期状态",
      "dataType": "enum",
      "required": true,
      "constraints": {
        "enumValues": ["DRAFT", "PROPOSED", "APPROVED", "ARCHIVED"]
      }
    },
    {
      "objectType": "build_plan",
      "code": "body",
      "name": "正文",
      "dataType": "string",
      "required": false
    },
    {
      "objectType": "build_plan_item",
      "code": "code",
      "name": "编码",
      "dataType": "string",
      "required": true
    },
    {
      "objectType": "build_plan_item",
      "code": "name",
      "name": "名称",
      "dataType": "string",
      "required": true
    },
    {
      "objectType": "build_plan_item",
      "code": "quantity",
      "name": "数量",
      "dataType": "number",
      "required": true
    }
  ],
  "relations": [
    {
      "code": "build_plan_satisfies_requirement",
      "name": "满足需求",
      "source": "build_plan",
      "target": "procurement_requirement",
      "direction": "directed",
      "cardinality": "many_to_many",
      "semantics": "weak",
      "hierarchical": false
    },
    {
      "code": "build_plan_contains_item",
      "name": "包含明细",
      "source": "build_plan",
      "target": "build_plan_item",
      "direction": "directed",
      "cardinality": "one_to_many",
      "semantics": "strong",
      "hierarchical": true
    },
    {
      "code": "build_plan_item_selects_product",
      "name": "选择配件",
      "source": "build_plan_item",
      "target": "hardware_product",
      "direction": "directed",
      "cardinality": "many_to_many",
      "semantics": "weak",
      "hierarchical": false
    },
    {
      "code": "build_plan_item_uses_supplier_quote",
      "name": "使用报价",
      "source": "build_plan_item",
      "target": "supplier_quote",
      "direction": "directed",
      "cardinality": "many_to_many",
      "semantics": "weak",
      "hierarchical": false
    },
    {
      "code": "supplier_quote_for_product",
      "name": "对应配件",
      "source": "supplier_quote",
      "target": "hardware_product",
      "direction": "directed",
      "cardinality": "many_to_many",
      "semantics": "weak",
      "hierarchical": false
    },
    {
      "code": "supplier_quote_offered_by_supplier",
      "name": "由供应商提供",
      "source": "supplier_quote",
      "target": "supplier",
      "direction": "directed",
      "cardinality": "many_to_many",
      "semantics": "weak",
      "hierarchical": false
    }
  ],
  "derived": [
    {
      "objectType": "procurement_requirement",
      "code": "total_budget_cny_fx",
      "name": "总预算（元）",
      "resultType": "number",
      "derivation": "field('unit_budget_cny') * field('quantity')"
    },
    {
      "objectType": "build_plan_item",
      "code": "selected_unit_price_cny_fx",
      "name": "选中单价（元）",
      "resultType": "number",
      "derivation": "sum(traverse('build_plan_item_uses_supplier_quote','out'),'unit_price_cny')"
    },
    {
      "objectType": "build_plan_item",
      "code": "total_price_cny_fx",
      "name": "明细总价（元）",
      "resultType": "number",
      "derivation": "field('selected_unit_price_cny_fx') * field('quantity')"
    },
    {
      "objectType": "build_plan_item",
      "code": "power_w_fx",
      "name": "明细功耗（瓦）",
      "resultType": "number",
      "derivation": "sum(traverse('build_plan_item_selects_product','out'),'power_w') * field('quantity')"
    },
    {
      "objectType": "build_plan_item",
      "code": "quote_inventory_fx",
      "name": "报价库存",
      "resultType": "number",
      "derivation": "sum(traverse('build_plan_item_uses_supplier_quote','out'),'inventory_qty')"
    },
    {
      "objectType": "build_plan_item",
      "code": "selected_performance_score_fx",
      "name": "明细性能分",
      "resultType": "number",
      "derivation": "sum(traverse('build_plan_item_selects_product','out'),'performance_score')"
    },
    {
      "objectType": "build_plan",
      "code": "total_price_cny_fx",
      "name": "方案总价（元）",
      "resultType": "number",
      "derivation": "sum(traverse('build_plan_contains_item','out'),'total_price_cny_fx')"
    },
    {
      "objectType": "build_plan",
      "code": "total_power_w_fx",
      "name": "方案总功耗（瓦）",
      "resultType": "number",
      "derivation": "sum(traverse('build_plan_contains_item','out'),'power_w_fx')"
    },
    {
      "objectType": "build_plan",
      "code": "total_performance_score_fx",
      "name": "方案性能分",
      "resultType": "number",
      "derivation": "sum(traverse('build_plan_contains_item','out'),'selected_performance_score_fx')"
    },
    {
      "objectType": "build_plan",
      "code": "power_supply_capacity_w_fx",
      "name": "电源容量（瓦）",
      "resultType": "number",
      "derivation": "sum(traverseFrom(traverse('build_plan_contains_item','out'),'build_plan_item_selects_product','out'),'psu_capacity_w')"
    },
    {
      "objectType": "build_plan",
      "code": "cpu_mainboard_platform_span_fx",
      "name": "CPU/主板平台范围",
      "resultType": "number",
      "derivation": "max(traverseFrom(traverse('build_plan_contains_item','out'),'build_plan_item_selects_product','out'),'cpu_mainboard_platform_code') - min(traverseFrom(traverse('build_plan_contains_item','out'),'build_plan_item_selects_product','out'),'cpu_mainboard_platform_code')"
    },
    {
      "objectType": "build_plan",
      "code": "memory_platform_span_fx",
      "name": "内存平台范围",
      "resultType": "number",
      "derivation": "max(traverseFrom(traverse('build_plan_contains_item','out'),'build_plan_item_selects_product','out'),'memory_platform_code') - min(traverseFrom(traverse('build_plan_contains_item','out'),'build_plan_item_selects_product','out'),'memory_platform_code')"
    },
    {
      "objectType": "build_plan",
      "code": "requirement_budget_cny_fx",
      "name": "需求总预算（元）",
      "resultType": "number",
      "derivation": "sum(traverse('build_plan_satisfies_requirement','out'),'total_budget_cny_fx')"
    },
    {
      "objectType": "build_plan",
      "code": "requirement_unit_budget_cny_fx",
      "name": "需求单台预算（元）",
      "resultType": "number",
      "derivation": "sum(traverse('build_plan_satisfies_requirement','out'),'unit_budget_cny')"
    }
  ],
  "rules": [
    {
      "code": "R-PC-BUDGET",
      "objectType": "build_plan",
      "severity": "BLOCK",
      "when": "field('total_price_cny_fx') > field('requirement_unit_budget_cny_fx')",
      "message": "采购方案总价超过需求单台预算，请调整配件数量或供应商报价",
      "lightweight": false
    },
    {
      "code": "R-PC-POWER",
      "objectType": "build_plan",
      "severity": "BLOCK",
      "when": "field('total_power_w_fx') * 1.2 > field('power_supply_capacity_w_fx')",
      "message": "采购方案电源容量未保留至少 20% 安全余量，请调整配件或电源",
      "lightweight": false
    },
    {
      "code": "R-PC-CPU-MAINBOARD",
      "objectType": "build_plan",
      "severity": "BLOCK",
      "when": "field('cpu_mainboard_platform_span_fx') > 0",
      "message": "CPU 与主板平台不一致，请重新选择兼容配件",
      "lightweight": false
    },
    {
      "code": "R-PC-MEMORY",
      "objectType": "build_plan",
      "severity": "BLOCK",
      "when": "field('memory_platform_span_fx') > 0",
      "message": "内存平台与 CPU 或主板不一致，请重新选择兼容配件",
      "lightweight": false
    },
    {
      "code": "R-PC-INVENTORY",
      "objectType": "build_plan_item",
      "severity": "WARN",
      "when": "field('quantity') > field('quote_inventory_fx')",
      "message": "采购明细数量超过供应商报价库存，请调整数量或报价",
      "lightweight": false
    },
    {
      "code": "R-PC-ITEM-SELECTION",
      "objectType": "build_plan_item",
      "severity": "BLOCK",
      "when": "relationCount('build_plan_item_selects_product') != 1 || relationCount('build_plan_item_uses_supplier_quote') != 1",
      "message": "每条方案明细必须恰好选择一个配件和一个供应商报价",
      "lightweight": false
    }
  ]
}
