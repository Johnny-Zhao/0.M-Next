  "relations": [
    {
      "code": "proposal_contains_system",
      "name": "Contains",
      "source": "proposal",
      "target": "system",
      "direction": "directed",
      "cardinality": "one_to_many",
      "semantics": "strong",
      "hierarchical": true
    },
    {
      "code": "proposal_contains_module",
      "name": "Contains",
      "source": "proposal_node",
      "target": "module",
      "direction": "directed",
      "cardinality": "one_to_many",
      "semantics": "strong",
      "hierarchical": true
    },
    {
      "code": "proposal_depends_on",
      "name": "Depends On",
      "source": "module",
      "target": "module",
      "direction": "directed",
      "cardinality": "many_to_many",
      "semantics": "weak",
      "hierarchical": false
    },
    {
      "code": "proposal_interfaces_with",
      "name": "Interfaces With",
      "source": "module",
      "target": "interface",
      "direction": "undirected",
      "cardinality": "many_to_many",
      "semantics": "weak",
      "hierarchical": false
    },
    {
      "code": "proposal_satisfies",
      "name": "Satisfies",
      "source": "module",
      "target": "requirement",
      "direction": "directed",
      "cardinality": "many_to_many",
      "semantics": "weak",
      "hierarchical": false
    }
  ],
  "derived": [
    {
      "objectType": "proposal",
      "code": "total_power_fx",
      "name": "Total Power",
      "resultType": "number",
      "derivation": "sum(traverseDeep('proposal_contains_module','out',5),'power_w')"
    },
    {
      "objectType": "module",
      "code": "child_count_fx",
      "name": "Child Count",
      "resultType": "number",
      "derivation": "count(traverse('proposal_contains_module','out'))"
    }
  ],
  "rules": [
    {
      "code": "R-TD-PWR",
      "objectType": "proposal",
      "severity": "BLOCK",
      "when": "field('power_budget_w') != null && field('total_power_fx') > field('power_budget_w')",
      "message": "模块功耗总和超过方案预算，请下调功耗或调整预算",
      "lightweight": false
    },
    {
      "code": "R-TD-RESP",
      "objectType": "module",
      "severity": "WARN",
      "when": "isBlank(field('responsibility'))",
      "message": "模块缺少 responsibility",
      "lightweight": false
    },
    {
      "code": "R-TD-IF",
      "objectType": "interface",
      "severity": "WARN",
      "when": "isBlank(field('protocol')) || isBlank(field('data'))",
      "message": "接口缺少 protocol 或 data",
      "lightweight": false
    },
    {
      "code": "R-TD-COV",
      "objectType": "requirement",
      "severity": "WARN",
      "when": "relationCount('proposal_satisfies') == 0",
      "message": "需求未被模块 satisfies 覆盖",
      "lightweight": false
    }
  ]
}
