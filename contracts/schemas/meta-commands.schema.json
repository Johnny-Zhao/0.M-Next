{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.local/contracts/meta-commands/1.1",
  "title": "元模型(M2)授权命令信封与载荷契约 v1.1(addendum:泛化/重定义/值类型)",
  "type": "object",
  "required": ["commandType", "workspaceId", "correlationId", "idempotencyKey", "payload"],
  "additionalProperties": false,
  "properties": {
    "commandType": {
      "enum": ["DefineObjectType", "DefineFieldDef", "DefineRelationType", "DefineValueType", "PublishTemplateVersion", "InstantiateWorkspace", "ApplyTemplateVersion", "DefineDerivedField"]
    },
    "workspaceId": { "$ref": "#/$defs/uuid" },
    "correlationId": { "$ref": "#/$defs/uuid" },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
    "payload": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "commandType": { "const": "DefineObjectType" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/DefineObjectType" } } } },
    { "if": { "properties": { "commandType": { "const": "DefineFieldDef" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/DefineFieldDef" } } } },
    { "if": { "properties": { "commandType": { "const": "DefineRelationType" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/DefineRelationType" } } } },
    { "if": { "properties": { "commandType": { "const": "DefineValueType" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/DefineValueType" } } } },
    { "if": { "properties": { "commandType": { "const": "PublishTemplateVersion" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/PublishTemplateVersion" } } } },
    { "if": { "properties": { "commandType": { "const": "InstantiateWorkspace" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/InstantiateWorkspace" } } } },
    { "if": { "properties": { "commandType": { "const": "ApplyTemplateVersion" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/ApplyTemplateVersion" } } } },
    { "if": { "properties": { "commandType": { "const": "DefineDerivedField" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/DefineDerivedField" } } } }
  ],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "code": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*$", "description": "snake_case 标识符" },
    "dataType": { "enum": ["string", "text", "integer", "number", "boolean", "date", "datetime", "enum", "ref", "json"] },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "description": "按根原语取用;不相容组合返回 KERNEL-422-FIELD-CONSTRAINT-INVALID",
      "properties": {
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 1 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "pattern": { "type": "string", "maxLength": 256, "description": "白名单正则;禁灾难性回溯" },
        "enumValues": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "refObjectTypeCode": { "$ref": "#/$defs/code", "description": "根原语=ref 时必填,指向对象类型 code" },
        "multiline": { "type": "boolean", "description": "根原语=text 的子值类型可声明(如自然段);仅声明性" }
      }
    },
    "DefineObjectType": {
      "type": "object",
      "required": ["code", "name"],
      "additionalProperties": false,
      "properties": {
        "templateVersionId": { "$ref": "#/$defs/uuid", "description": "可空:NULL=无模板直挂(兼容 demo);非空必须指向 draft 模板版本,published 下定义返回 KERNEL-409-TEMPLATE-VERSION-IMMUTABLE" },
        "code": { "$ref": "#/$defs/code", "description": "(workspace, code) 唯一" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "parentTypeCode": { "$ref": "#/$defs/code", "description": "可空:父对象类型 code(单继承)。须同 workspace+同模板版本(否则 META-422-PARENT-CROSS-TEMPLATE)、存在(否则 META-422-PARENT-NOT-FOUND)、不成环(否则 META-422-GENERALIZATION-CYCLE)" }
      }
    },
    "DefineValueType": {
      "type": "object",
      "required": ["code", "name", "basePrimitive"],
      "additionalProperties": false,
      "properties": {
        "templateVersionId": { "$ref": "#/$defs/uuid", "description": "可空,同 DefineObjectType 语义" },
        "code": { "$ref": "#/$defs/code", "description": "(workspace, code) 唯一,含内置根" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "basePrimitive": { "$ref": "#/$defs/dataType", "description": "所属根原语;须与父值类型一致,否则 META-422-VALUETYPE-BASE-MISMATCH" },
        "parentValueTypeCode": { "$ref": "#/$defs/code", "description": "可空:父值类型 code(NULL=自身即根)。不成环;约束相对父只收紧,放宽返回 META-422-REDEFINITION-INCONSISTENT" },
        "constraints": { "$ref": "#/$defs/constraints" }
      }
    },
    "DefineFieldDef": {
      "type": "object",
      "required": ["objectTypeId", "code", "name"],
      "additionalProperties": false,
      "oneOf": [
        { "required": ["dataType"] },
        { "required": ["valueTypeCode"] }
      ],
      "properties": {
        "objectTypeId": { "$ref": "#/$defs/uuid", "description": "归属对象类型,不存在返回 KERNEL-404-TYPE-NOT-FOUND" },
        "code": { "$ref": "#/$defs/code", "description": "(objectType, code) 唯一;若同 code 在祖先链存在则须经 redefinesFieldCode 重定义" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "dataType": { "$ref": "#/$defs/dataType", "description": "内置根原语路径;与 valueTypeCode 二选一" },
        "valueTypeCode": { "$ref": "#/$defs/code", "description": "命名值类型(内置根或自定义子类)路径;与 dataType 二选一。不存在返回 META-422-PARENT-NOT-FOUND" },
        "required": { "type": "boolean", "default": false },
        "redefinesFieldCode": { "$ref": "#/$defs/code", "description": "可空:重定义祖先链上同 code 字段;触发协变收紧一致性校验,放宽返回 META-422-REDEFINITION-INCONSISTENT" },
        "constraints": { "$ref": "#/$defs/constraints" }
      }
    },
    "DefineRelationType": {
      "type": "object",
      "required": ["code", "sourceTypeId", "targetTypeId", "direction", "cardinality", "semantics"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/code", "description": "(workspace, code) 唯一" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sourceTypeId": { "$ref": "#/$defs/uuid" },
        "targetTypeId": { "$ref": "#/$defs/uuid" },
        "direction": { "enum": ["directed", "undirected"] },
        "cardinality": { "enum": ["one_to_one", "one_to_many", "many_to_many"] },
        "semantics": { "enum": ["weak", "strong"] },
        "hierarchical": { "type": "boolean", "default": false, "description": "true 必须 cardinality=one_to_many(承 V2 约束),违反返回 KERNEL-422-FIELD-CONSTRAINT-INVALID" }
      }
    },
    "PublishTemplateVersion": {
      "type": "object",
      "required": ["templateVersionId"],
      "additionalProperties": false,
      "properties": {
        "templateVersionId": { "$ref": "#/$defs/uuid", "description": "draft→published;已 published 重复发布返回 KERNEL-409-TEMPLATE-VERSION-IMMUTABLE;空模板版本可返回 KERNEL-422-TEMPLATE-EMPTY" }
      }
    },
    "InstantiateWorkspace": {
      "type": "object",
      "required": ["templateId", "version", "newWorkspaceId", "workspaceName"],
      "additionalProperties": false,
      "properties": {
        "templateId": { "$ref": "#/$defs/uuid" },
        "version": { "type": "integer", "minimum": 1, "description": "必须为该模板已 published 的版本号,否则 KERNEL-422-TEMPLATE-NOT-PUBLISHED" },
        "newWorkspaceId": { "$ref": "#/$defs/uuid", "description": "客户端提供的新工作空间 id(幂等);信封 workspaceId 为操作上下文" },
        "workspaceName": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "ApplyTemplateVersion": {
      "type": "object",
      "required": ["toVersion"],
      "additionalProperties": false,
      "properties": {
        "toVersion": { "type": "integer", "minimum": 1, "description": "目标工作空间=信封 workspaceId;含收紧项返回 KERNEL-409-TEMPLATE-MIGRATION-REQUIRED + 受影响存量" }
      }
    },
    "DefineDerivedField": {
      "type": "object",
      "required": ["objectTypeId", "code", "name", "resultType", "derivation"],
      "additionalProperties": false,
      "properties": {
        "templateVersionId": { "$ref": "#/$defs/uuid", "description": "可空,同 DefineObjectType 语义" },
        "objectTypeId": { "$ref": "#/$defs/uuid", "description": "归属对象类型,不存在返回 KERNEL-404-TYPE-NOT-FOUND" },
        "code": { "$ref": "#/$defs/code", "description": "(objectType, code) 唯一;不可与已有 stored 字段同 code" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "resultType": { "$ref": "#/$defs/dataType", "description": "派生结果类型(number/integer/boolean/text 等)" },
        "derivation": { "type": "string", "minLength": 1, "maxLength": 4000, "description": "派生表达式;语法错→DERIVE-400-SYNTAX-INVALID;依赖成环→DERIVE-409-DEPENDENCY-CYCLE;求值超界→DERIVE-422-EVAL-LIMIT" }
      }
    }
  }
}
