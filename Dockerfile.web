ARG REGISTRY_PREFIX=docker.io
FROM ${REGISTRY_PREFIX}/node:22-alpine AS build
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/views/package.json packages/views/package.json
COPY packages/web/package.json packages/web/package.json
RUN pnpm install --frozen-lockfile
COPY packages/views packages/views
COPY packages/web packages/web
RUN pnpm --filter @m-next/views build && pnpm --filter @m-next/web build

ARG REGISTRY_PREFIX=docker.io
FROM ${REGISTRY_PREFIX}/nginx:1.27-alpine
COPY config/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/packages/web/dist /usr/share/nginx/html
EXPOSE 8080
